{
 "id": "dia-gnau-agglopolys",
 "name": "DIA — guichet d'Agglopolys",
 "version": 1,
 "auto": true,
 "pagesMax": 10,
 "saisieDirecte": true,
 "note": "Guichet d'Agglopolys (relevé de l'étude, 16/10) : CLAIRE clique la démarche dans « Formuler », choisit la commune de dépôt, répond NON aux fenêtres de récupération et de déconnexion, puis remplit chaque page par les codes du CERFA (#code) et passe à la suivante. Elle s'arrête à la dernière page : relire, joindre les pièces (étape manuelle), « Vérifier ma saisie », puis transmettre soi-même. « Transmettre ma demande » n'est jamais cliqué ; les listes calculées par le site (OPLSTPARCELLE, OPLSTCOPRO, COMMISSION) et le prix en lettres (FI1C) ne sont jamais écrits. Les cases de déclaration (GI1DA1, GI5AA1, GI6AA1) ne sont jamais cochées par CLAIRE.",
 "entree": {
  "commune": {
   "source": "terrain.commune",
   "selecteur": ".modal select",
   "valider": [
    "^valider la commune( de depot)?$"
   ]
  },
  "fenetresNon": [
   "(voulez|souhaitez)-vous (vraiment )?vous deconnecter",
   "confirmez-vous la deconnexion"
  ],
  "sessionExpiree": "me connecter a mon compte",
  "urlSaisie": "#/saisie/",
  "bouton": [
   "^(declaration d.)?intention d.aliener( \\(dia\\))?$",
   "^dia$",
   "^.{0,60} \\(dia\\)$"
  ],
  "fenetresNonEntree": [
   "voulez-vous recuperer les donnees non sauvegardees",
   "recuperer les donnees non sauvegardees \\?"
  ]
 },
 "suivantSelecteur": "[ng-click=\"vm.nextPage()\"]",
