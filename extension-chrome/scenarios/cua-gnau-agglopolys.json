{
 "id": "cua-gnau-agglopolys",
 "name": "CUa — guichet d'Agglopolys",
 "version": 2,
 "auto": true,
 "pagesMax": 7,
 "saisieDirecte": true,
 "note": "Guichet d'Agglopolys (relevé de l'étude, 16/10) : CLAIRE clique la démarche dans « Formuler », choisit la commune de dépôt, répond NON aux fenêtres de récupération et de déconnexion, puis remplit chaque page par les codes du CERFA (#code) et passe à la suivante. Elle s'arrête à la dernière page : relire, joindre les pièces (étape manuelle), « Vérifier ma saisie », puis transmettre soi-même. « Transmettre ma demande » n'est jamais cliqué ; les listes calculées par le site (OPLSTPARCELLE, OPLSTCOPRO, COMMISSION) et le prix en lettres (FI1C) ne sont jamais écrits. Adresse du bien et parcelles : par les assistants du guichet (« Assistant de saisie d'adresse », « Assistant de saisie des références cadastrales »), comme l'étude les remplit (vidéo du 17/10).",
 "entree": {
  "commune": {
   "source": "terrain.commune",
   "selecteur": ".modal select",
   "valider": [
    "^valider la commune( de depot)?$"
   ]
  },
  "fenetresNon": [
   "(voulez|souhaitez)-vous (vraiment )?vous deconnecter",
   "confirmez-vous la deconnexion"
  ],
  "sessionExpiree": "me connecter a mon compte",
  "urlSaisie": "#/saisie/",
  "bouton": [
   "^(demande de )?certificat d.urbanisme d.information( \\(cu ?a\\))?$",
   "^cu ?a$",
   "^.{0,60} \\(cu ?a\\)$"
  ],
  "fenetresNonEntree": [
   "voulez-vous recuperer les donnees non sauvegardees",
   "recuperer les donnees non sauvegardees \\?"
  ]
 },
 "suivantSelecteur": "[ng-click=\"vm.nextPage()\"]",
 "pages": [
  {
   "title": "Toutes les pages du brouillon",
   "waitFor": "body",
