{
 "id": "dia-gnau",
 "name": "DIA — guichet unique (GNAU)",
 "version": 2,
 "auto": true,
 "pagesMax": 30,
 "refuserSiNoms": "^DI[0-9A-Z]",
 "attendreNoms": "^AI1",
 "note": "CLAIRE ouvre la démarche (Nouvelle demande › Déclaration d'intention d'aliéner), remplit chaque page puis clique « Suivant », et s'arrête avant la validation. Ancien CERFA (codes DI…) refusé. Les cases du CERFA à cocher selon l'acte restent à l'étude (le guichet recalcule ses listes cachées).",
 "etapes": [
  {
   "label": "Nouvelle demande",
   "textes": [
    "^(nouvelle demande|deposer une( nouvelle)? demande|creer une( nouvelle)? demande|nouveau dossier|deposer un dossier|faire une demande|nouvelle demarche|deposer une demarche)$"
   ]
  },
  {
   "label": "Déclaration d'intention d'aliéner",
   "textes": [
    "intention d.aliener",
    "^dia\\b"
   ]
  }
 ],
 "suivant": [
  "^(suivant|etape suivante|page suivante|continuer|aller a l.etape suivante)( ?[>›»])?$"
 ],
 "pages": [
  {
   "title": "Toutes les pages du guichet",
   "waitFor": "body",
   "fields": [
    {
     "label": "Vendeur — personne physique ou morale",
     "source": "vendeur.morale",
     "type": "choix",
     "choix": {
      "true": "personne morale|societe",
      "false": "personne physique|particulier"
     },
     "rubrique": "propriet|vendeur|cedant|declarant|alienateur",
     "optional": true
    },
    {
     "label": "Vendeur — nom (code AI1NP1)",
     "source": "vendeur.nom",
     "code": "AI1NP1",
     "libelles": [
      "^nom( de naissance| de famille| patronymique)?$"
     ],
     "rubrique": "propriet|vendeur|cedant|declarant|alienateur",
     "horsRubrique": "acquereur|cessionnaire|mandataire|notaire|signature",
     "transform": "upper"
    },
    {
     "label": "Vendeur — prénom (code AI1PP1)",
     "source": "vendeur.prenom",
     "code": "AI1PP1",
     "libelles": [
      "^prenoms?$"
     ],
     "rubrique": "propriet|vendeur|cedant|declarant|alienateur",
     "horsRubrique": "acquereur|cessionnaire|mandataire|notaire|signature"
    },
    {
