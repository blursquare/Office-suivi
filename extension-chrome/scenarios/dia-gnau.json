{
  "id": "dia-gnau",
  "name": "DIA — guichet unique (GNAU)",
  "version": 1,
  "pageAffichee": true,
  "refuserSiNoms": "^DI[0-9A-Z]",
  "attendreNoms": "^AI1",
  "note": "Codes de champs du CERFA actuel relevés par l'étude sur le GNAU d'Agglopolys (HANDOFF §10). Ancien CERFA (codes DI…) : arrêt. Les cases du CERFA se cochent à la main (le guichet recalcule ses listes cachées). Les champs sans code se copient depuis le panneau tant que leur emplacement n'est pas relevé.",
  "pages": [
    {
      "title": "Page affichée du guichet",
      "waitFor": "form, body",
      "fields": [
        { "label": "Vendeur — nom (code AI1NP1)", "source": "vendeur.nom", "code": "AI1NP1", "type": "text", "transform": "upper" },
        { "label": "Vendeur — prénom (code AI1PP1)", "source": "vendeur.prenom", "code": "AI1PP1", "type": "text" },
        { "label": "Vendeur — société (raison sociale)", "source": "vendeur.raisonSociale", "type": "text", "optional": true },
        { "label": "Vendeur — date de naissance", "source": "vendeur.dateNaissance", "type": "text", "transform": "date_jjmmaaaa", "optional": true },
        { "label": "Vendeur — commune de naissance", "source": "vendeur.lieuNaissance", "type": "text", "optional": true },
        { "label": "Vendeur — département de naissance", "source": "vendeur.departementNaissance", "type": "text", "optional": true },
        { "label": "Vendeur — profession", "source": "vendeur.profession", "type": "text", "optional": true },
        { "label": "Vendeur — adresse (numéro)", "source": "vendeur.adresse.numero", "type": "text", "optional": true },
        { "label": "Vendeur — adresse (voie)", "source": "vendeur.adresse.voie", "type": "text", "optional": true },
        { "label": "Vendeur — code postal", "source": "vendeur.adresse.codePostal", "type": "text", "optional": true },
        { "label": "Vendeur — commune", "source": "vendeur.adresse.commune", "type": "text", "optional": true },
        { "label": "2ᵉ propriétaire — nom (code AI1NP2)", "source": "vendeurs.codemandeurs.0.nom", "code": "AI1NP2", "type": "text", "transform": "upper", "optional": true },
        { "label": "2ᵉ propriétaire — prénom (code AI1PP2)", "source": "vendeurs.codemandeurs.0.prenom", "code": "AI1PP2", "type": "text", "optional": true },
        {
          "forEach": "vendeurs.codemandeurs", "max": 4,
          "fields": [
            { "label": "Codemandeur {n} — nom", "source": "{list}.{i}.nom", "type": "text", "optional": true },
            { "label": "Codemandeur {n} — prénom", "source": "{list}.{i}.prenom", "type": "text", "optional": true },
            { "label": "Codemandeur {n} — date de naissance", "source": "{list}.{i}.dateNaissance", "type": "text", "transform": "date_jjmmaaaa", "optional": true },
            { "label": "Codemandeur {n} — commune de naissance", "source": "{list}.{i}.lieuNaissance", "type": "text", "optional": true },
            { "label": "Codemandeur {n} — adresse", "source": "{list}.{i}.adresse.complete", "type": "text", "optional": true },
            { "label": "Codemandeur {n} — profession", "source": "{list}.{i}.profession", "type": "text", "optional": true }
          ]
        },
        { "label": "Parcelles (format du guichet)", "source": "parcelles", "type": "text", "transform": "parcelles_dia", "encoded": true },
        { "label": "Superficie totale, m² (code D5T)", "source": "superficie", "code": "D5T", "type": "text", "transform": "surface", "optional": true },
        { "label": "Lots de copropriété (format du guichet)", "source": "lots", "type": "text", "transform": "lots_copro", "encoded": true, "optional": true },
        { "label": "Prix, en chiffres", "source": "prix", "type": "text", "transform": "entier" },
        { "label": "Prix, en lettres", "source": "prix", "type": "text", "transform": "prix_lettres" },
        { "label": "Mobilier, en chiffres", "source": "mobilier", "type": "text", "transform": "entier", "optional": true },
        { "label": "Commission (format du guichet)", "source": "commission", "type": "text", "transform": "commission", "encoded": true, "optional": true },
        { "label": "Acquéreur — nom", "source": "acquereur.nom", "type": "text", "transform": "upper", "optional": true },
        { "label": "Acquéreur — prénom", "source": "acquereur.prenom", "type": "text", "optional": true },
        { "label": "Acquéreur — société", "source": "acquereur.raisonSociale", "type": "text", "optional": true },
        { "label": "Acquéreur — adresse", "source": "acquereur.adresse.complete", "type": "text", "optional": true },
        { "label": "Acquéreur — profession", "source": "acquereur.profession", "type": "text", "optional": true },
        { "label": "Fait à (code E1L)", "source": "signature.lieu", "code": "E1L", "type": "text" },
        { "label": "Le (code E1D)", "source": "signature.date", "code": "E1D", "type": "text", "transform": "date_jjmmaaaa" },
        { "label": "Signature (code E1S)", "source": "signature.signataire", "code": "E1S", "type": "text" }
      ]
    }
  ]
}
