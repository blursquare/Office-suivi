{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": [
      "es2022",
      "dom"
    ],
    "types": [
      "node"
    ],
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "commun/**/*.js",
    "scripts/**/*.js",
    "server/src/**/*.js"
  ]
}
