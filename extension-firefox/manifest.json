{
  "manifest_version": 2,
  "name": "CLAIRE pour Authentic",
  "version": "0.2.0",
  "description": "Envoie le dossier Authentic affiché à CLAIRE, sur le réseau de l'office.",
  "browser_specific_settings": {
    "gecko": {
      "id": "claire-authentic@etude-gossart.local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    }
  },
  "icons": {
    "48": "icone.svg",
    "96": "icone.svg"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "optional_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "browser_action": {
    "default_title": "Envoyer à CLAIRE",
    "default_icon": "icone.svg"
  },
  "background": {
    "scripts": [
      "fond.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "browser_style": false
  }
}
