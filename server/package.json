{
  "name": "claire-serveur",
  "version": "1.0.0",
  "private": true,
  "description": "Serveur intranet pour CLAIRE (Registre des échéances) — registre partagé en temps réel, relances email automatiques, flux calendrier webcal. Voir /server/README.md pour le déploiement.",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "test": "node --test",
    "build:exe": "node scripts/build-windows-exe.mjs",
    "relais": "node scripts/compiler-relais.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.2",
    "httpntlm": "^1.8.13",
    "nodemailer": "^10.0.9"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "resedit": "^3.1.0"
  }
}
