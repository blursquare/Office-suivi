# Copier ce fichier en `.env` (jamais commité, voir .gitignore) et renseigner les valeurs
# réelles avant de démarrer le serveur. Voir server/README.md pour le déploiement complet.

# Port d'écoute HTTP du serveur.
PORT=3000

# Mot de passe partagé entre tous les collaborateurs de l'étude (obligatoire).
AUTH_PASSWORD=

# Jeton utilisé dans l'URL du flux calendrier (GET /calendrier.ics?token=...) — un abonnement
# webcal ne peut pas envoyer de mot de passe/en-tête, ce jeton en tient lieu. Générer une chaîne
# longue et aléatoire (ex. `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`).
CALENDRIER_TOKEN=

# Identifiants SMTP pour les relances email automatiques (M4) — laisser vide pour désactiver
# cette fonctionnalité tant que l'étude n'a pas fourni de compte (le serveur démarre normalement
# sans, seules les relances automatiques restent inactives).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
